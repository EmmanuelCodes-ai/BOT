# ============================================================
# Multi-Strategy Trading Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# ============================================================

# ── Exchange ─────────────────────────────────────────────────
# Any CCXT-supported exchange ID (e.g. binance, bybit, okx, phemex)
EXCHANGE_ID=bybit

# Your exchange API credentials
# For paper trading, use the exchange's TESTNET/SANDBOX keys
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Market type: "future" (perpetual/delivery) or "spot"
MARKET_TYPE=future

# ── Trading pair ──────────────────────────────────────────────
# Must be available on the exchange in the selected market type
SYMBOL=BTC/USDT:USDT

# ── Risk management ───────────────────────────────────────────
# Fraction of account balance risked per trade (0.01 = 1%)
RISK_PER_TRADE_PCT=0.01

# Target risk-to-reward ratio (2 = 2R per trade)
RISK_REWARD_RATIO=2

# ATR multiplier for stop-loss distance (stop = entry ± ATR × multiplier)
ATR_MULTIPLIER_SL=1.5

# ── Leverage & Position Sizing ────────────────────────────────
# Account leverage used on Bybit (default: 10 = 10x)
LEVERAGE=10

# ── Fixed Position Sizing (Rule 1) ────────────────────────────
# Every trade uses a fixed margin amount × leverage — never scales with equity.
# This prevents position values from ballooning as the account grows.
#
# Margin allocated per trade in USDT (e.g. $200 → $2,000 notional at 10x leverage)
# Clamped automatically between $50 minimum and MAX_POSITION_MARGIN.
FIXED_MARGIN_PER_TRADE=200
#
# Hard upper bound on margin per trade. Even if FIXED_MARGIN_PER_TRADE is set higher,
# this cap is enforced. Default: $300.
MAX_POSITION_MARGIN=300

# ── Limit Orders Only (Rule 2) ────────────────────────────────
# All entries, partial profit exits, and stop-loss closes use LIMIT orders (Maker).
# PostOnly ensures you never pay Taker fees. If the limit would cross the book
# (immediate fill), it falls back to a standard GTC limit order automatically.
# Set to false only if you need guaranteed immediate fills (not recommended).
LIMIT_ORDER_POST_ONLY=true

# ── Dynamic Stop-Loss & Incremental Closing (Rule 3) ──────────
# Instead of a single all-or-nothing stop-loss, the bot closes portions
# of the position incrementally as price moves adversely.

# Enable stepped adverse de-risking (close tranches before the full stop is hit)
ENABLE_STEPPED_STOP_LOSS=true
#
# Comma-separated list of adverse-distance ratios to trigger each tranche.
# 0.5 = when price has moved 50% of the way to the original stop distance.
# 0.75 = when price has moved 75% of the way to the original stop distance.
STEPPED_STOP_TRANCHES=0.5,0.75
#
# Fraction of current position size to close at each stepped stop tranche (0.5 = 50%)
STEPPED_STOP_CLOSE_PCT=0.5

# Enable dynamic trailing stop that ratchets behind peak favorable price
ENABLE_DYNAMIC_TRAILING_STOP=true
#
# Minimum Bybit Position ROI % required before trailing begins (e.g. 0.5 = +0.5% ROI)
# Should match or be slightly below PARTIAL_PROFIT_ROI_PCT so trailing starts early.
TRAILING_STOP_ACTIVATION_ROI=0.5
#
# Percentage of price distance to trail behind the peak favorable price.
# e.g. 0.3 = trail stop 0.3% behind peak (for BTC at $95,000 → trail ~$285 behind peak)
TRAILING_STOP_DISTANCE_PCT=0.3

# ── Early Partial Take-Profit & Dynamic Breakeven ────────────
# true = automatically locks in partial gains early when green & shifts SL to Breakeven
ENABLE_EARLY_PARTIALS=true
# Bybit Position ROI % to trigger early partial harvest (0.5 = +0.5% ROI on Bybit position card)
PARTIAL_PROFIT_ROI_PCT=0.5
# Percentage of position size to close at early partial trigger (0.5 = 50%)
PARTIAL_CLOSE_PCT=0.5
# Buffer percentage beyond entry price to cover exchange trading fees & slippage (e.g. 0.0005 = 0.05%)
BREAKEVEN_BUFFER_PCT=0.0005

# Maximum number of simultaneously open trades
MAX_OPEN_TRADES=2

# Minimum volume multiplier vs 20-period average to accept a signal
# Also used as the global pre-entry volume gate (see below)
MIN_VOLUME_MULTIPLIER=1.0

# ── Global Pre-Entry Market-Regime Filters ────────────────────
# These filters run centrally in the execution engine and block
# ALL strategy signals when the M5 market is compressed or illiquid.
#
# Master switch — set to false only for debugging / back-comparison
ENABLE_PRE_ENTRY_FILTERS=true
#
# Minimum Bollinger Bandwidth (upper-lower)/middle on M5.
# Below ~0.0025 the bands are extremely tight — entering here is
# dangerous as there's no directional energy to capture yet.
# Raise this (e.g. 0.003) to be more selective, lower (e.g. 0.002)
# to allow more signals in mildly-contracting markets.
MIN_BOLLINGER_BANDWIDTH=0.0025
#
# Minimum ATR Expansion Ratio: atr14 / 50-period average of atr14.
# A ratio < 1.0 means the market is quieter than its own historical norm.
# 0.85 = current volatility is at least 85% of its 50-candle average.
# Raise to 0.90 for a stricter expansion requirement.
# Lower to 0.75 to allow more signals during mild consolidations.
MIN_ATR_EXPANSION_RATIO=0.85

# ── Session window (UTC hours) ────────────────────────────────
# New York session: 13:00–21:00 UTC
SESSION_START_UTC=13
SESSION_END_UTC=21

# ── Timeframe ─────────────────────────────────────────────────
# Primary execution timeframe — do not change unless you adapt the strategies
TIMEFRAME=5m

# ── Paper trading ─────────────────────────────────────────────
# true  = orders are simulated locally (no real orders ever sent)
# false = LIVE trading with real money (use with extreme caution)
PAPER_TRADING=true

# Virtual account balance used for position sizing in paper trading mode
# Represents your simulated account size in quote currency (USDT)
PAPER_BALANCE=10000

# ── Bybit Demo Trading (RECOMMENDED for paper runs) ───────────
# Bybit's Demo Trading runs on mainnet infrastructure — fast and stable.
# Much more reliable than testnet.
#
# How to set up:
#   1. Log in to bybit.com
#   2. Switch to "Demo Trading" mode (top of the page)
#   3. Go to API Management and create a key there
#   4. Set BYBIT_DEMO_MODE=true and use those demo keys above
#
# Only applies when EXCHANGE_ID=bybit.
BYBIT_DEMO_MODE=true

# ── Sandbox / Testnet mode ────────────────────────────────────
# Only use this if you specifically have Bybit testnet credentials.
# Bybit testnet (testnet.bybit.com) is frequently slow or unavailable.
# Prefer BYBIT_DEMO_MODE=true instead.
SANDBOX_MODE=false

# ── Logging ───────────────────────────────────────────────────
# Winston log level: error | warn | info | debug
LOG_LEVEL=info

# ── Unified AI Analyst Key Pool (19 NVIDIA + 19 OpenRouter) ─
# The bot rotates interleaved across all active keys and automatically
# rolls over instantly on rate limits (429), errors (5xx), or timeouts.

# NVIDIA NIM Keys (NVIDIA_API_KEY_1 .. NVIDIA_API_KEY_19)
NVIDIA_API_KEY_1=nvapi-xxxx
NVIDIA_API_KEY_2=nvapi-xxxx
# ... up to NVIDIA_API_KEY_19
# Optional: customize models per slot or globally (defaults to moonshotai/kimi-k3 & deepseek-ai/deepseek-v4-pro-0813)
# NVIDIA_MODEL=moonshotai/kimi-k3

# OpenRouter Keys (OPENROUTER_API_KEY_1 .. OPENROUTER_API_KEY_19)
OPENROUTER_API_KEY_1=sk-or-v1-xxxx
OPENROUTER_API_KEY_2=sk-or-v1-xxxx
# ... up to OPENROUTER_API_KEY_19
# Optional: customize models per slot or globally (defaults to deepseek/deepseek-chat & deepseek/deepseek-r1)
# OPENROUTER_MODEL=deepseek/deepseek-chat

