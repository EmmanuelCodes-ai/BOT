# ============================================================
# Multi-Strategy Trading Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# ============================================================

# ── Exchange ─────────────────────────────────────────────────
# Any CCXT-supported exchange ID (e.g. binance, bybit, okx, phemex)
EXCHANGE_ID=bybit

# Your exchange API credentials
# For paper trading, use the exchange's TESTNET/SANDBOX keys
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Market type: "future" (perpetual/delivery) or "spot"
MARKET_TYPE=future

# ── Trading pair ──────────────────────────────────────────────
# Must be available on the exchange in the selected market type
SYMBOL=BTC/USDT:USDT

# ── Risk management ───────────────────────────────────────────
# Fraction of account balance risked per trade (0.01 = 1%)
RISK_PER_TRADE_PCT=0.01

# Target risk-to-reward ratio (2 = 2R per trade)
RISK_REWARD_RATIO=2

# ATR multiplier for stop-loss distance (stop = entry ± ATR × multiplier)
ATR_MULTIPLIER_SL=1.5

# ── Early Partial Take-Profit & Dynamic Breakeven ────────────
# true = automatically locks in partial gains early when green & shifts SL to Breakeven
ENABLE_EARLY_PARTIALS=true
# R-multiple profit threshold to trigger early partial harvest (e.g. 0.4, 0.5, 0.6)
PARTIAL_TP_R=0.5
# Percentage of position size to close at early partial trigger (0.5 = 50%)
PARTIAL_CLOSE_PCT=0.5
# Buffer in R-multiples beyond entry price to cover exchange trading fees & slippage
BREAKEVEN_BUFFER_R=0.05

# Maximum number of simultaneously open trades
MAX_OPEN_TRADES=2

# Minimum volume multiplier vs 20-period average to accept a signal
MIN_VOLUME_MULTIPLIER=0.8

# ── Session window (UTC hours) ────────────────────────────────
# New York session: 13:00–21:00 UTC
SESSION_START_UTC=13
SESSION_END_UTC=21

# ── Timeframe ─────────────────────────────────────────────────
# Primary execution timeframe — do not change unless you adapt the strategies
TIMEFRAME=5m

# ── Paper trading ─────────────────────────────────────────────
# true  = orders are simulated locally (no real orders ever sent)
# false = LIVE trading with real money (use with extreme caution)
PAPER_TRADING=true

# Virtual account balance used for position sizing in paper trading mode
# Represents your simulated account size in quote currency (USDT)
PAPER_BALANCE=10000

# ── Bybit Demo Trading (RECOMMENDED for paper runs) ───────────
# Bybit's Demo Trading runs on mainnet infrastructure — fast and stable.
# Much more reliable than testnet.
#
# How to set up:
#   1. Log in to bybit.com
#   2. Switch to "Demo Trading" mode (top of the page)
#   3. Go to API Management and create a key there
#   4. Set BYBIT_DEMO_MODE=true and use those demo keys above
#
# Only applies when EXCHANGE_ID=bybit.
BYBIT_DEMO_MODE=true

# ── Sandbox / Testnet mode ────────────────────────────────────
# Only use this if you specifically have Bybit testnet credentials.
# Bybit testnet (testnet.bybit.com) is frequently slow or unavailable.
# Prefer BYBIT_DEMO_MODE=true instead.
SANDBOX_MODE=false

# ── Logging ───────────────────────────────────────────────────
# Winston log level: error | warn | info | debug
LOG_LEVEL=info

# ── AI Analyst (NVIDIA NIM / Kimi K3) ─────────────────────────
# NVIDIA NIM API key for the AI Analyst
NVIDIA_API_KEY=your_nvidia_api_key_here
